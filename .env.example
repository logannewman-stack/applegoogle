# Copy to .env and export, or set these in your process manager.
# Every value is optional — sensible defaults apply.

# Server
PORT=3000
HOST=127.0.0.1            # use 0.0.0.0 when deploying behind a reverse proxy
DATA_DIR=./data           # where the index, accounts, and usage live
TRUST_PROXY=0             # set to 1 only behind a proxy that sets X-Forwarded-For

# Northstar is free — the one limit is an anti-abuse ceiling, same for everyone
DAILY_FAIR_USE_CEILING=2000

# Crawler politeness
CRAWL_USER_AGENT=northstar-crawler/0.2 (respectful; obeys robots.txt)
CRAWL_DELAY_MS=1000
CRAWL_TIMEOUT_MS=10000
CRAWL_MAX_BYTES=2097152
