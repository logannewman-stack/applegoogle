# Copy to .env and export, or set these in your process manager.
# Every value is optional — sensible defaults apply.

# Server
PORT=3000
HOST=127.0.0.1            # use 0.0.0.0 when deploying behind a reverse proxy
DATA_DIR=./data           # where the index, accounts, and usage live
TRUST_PROXY=0             # set to 1 only behind a proxy that sets X-Forwarded-For

# Northstar is free — the one limit is an anti-abuse ceiling, same for everyone
DAILY_FAIR_USE_CEILING=2000

# Live web discovery. Off by default. When on, queries the local index answers
# poorly send Northstar out to READ the web: the provider names candidate URLs,
# Northstar fetches, indexes and ranks them itself.
WEB_DISCOVERY=0
SEARCH_PROVIDER=wikipedia        # wikipedia (no key) | brave | google | bing
# BRAVE_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=
# BING_API_KEY=
DISCOVERY_LIMIT=6                # candidate URLs fetched per expansion
DISCOVERY_MIN_RESULTS=3          # expand when a query returns fewer than this
DISCOVERY_COOLDOWN_MS=21600000   # don't re-expand the same query for 6 hours
DISCOVERY_BUDGET_MS=2500         # how long a search may wait for new pages

# Crawler politeness
CRAWL_USER_AGENT=northstar-crawler/0.3 (respectful; obeys robots.txt)
CRAWL_DELAY_MS=1000
CRAWL_TIMEOUT_MS=10000
CRAWL_MAX_BYTES=2097152
